{
  "name": "bonk-club",
  "version": "0.71.0",
  "releaseNotes": "Refinery with flowing fuel, breakable pipes and pressure explosions",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build --base=./",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check:fast": "node --test --test-reporter=dot tests/playability.test.js tests/preferences.test.js tests/render-state.test.js tests/snapshot-delta.test.js tests/network.test.js tests/platform-build.test.js tests/release-metadata.test.js && npm run build",
    "test": "node --test --test-reporter=dot tests/*.test.js",
    "test:stress": "node --test --test-reporter=dot tests/*.stress.js",
    "test:release": "npm test && npm run test:stress",
    "benchmark:netcode": "node scripts/benchmark-netcode.mjs",
    "benchmark:liquids": "node scripts/benchmark-liquids.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "steam:prepare": "node scripts/prepare-steam.mjs",
    "benchmark:performance": "node scripts/benchmark-performance.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "vite": "8.2.2"
  }
}
