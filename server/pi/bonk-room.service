[Unit]
Description=Bonk Club room signaling and relay credentials

[Service]
WorkingDirectory=%h/bonk-club
ExecStart=/usr/bin/python3 %h/bonk-club/server/pi/sandbox.py room
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077
MemoryMax=256M
CPUQuota=50%
TasksMax=64
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
