[Unit]
Description=Bonk Club room signaling and relay credentials

[Service]
WorkingDirectory=%h/bonk-club
ExecStart=%h/.local/node/bin/node %h/bonk-club/server/index.js %h/.config/bonk-club/server.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077
MemoryMax=256M
CPUQuota=50%
TasksMax=64
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
