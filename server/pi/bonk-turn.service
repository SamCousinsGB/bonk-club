[Unit]
Description=Bonk Club authenticated TURN relay
After=bonk-https.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 %h/bonk-club/server/pi/run-turn.py
Restart=on-failure
RestartSec=60
NoNewPrivileges=true
UMask=0077
MemoryMax=192M
CPUQuota=75%
TasksMax=64
LimitNOFILE=1024
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=default.target
